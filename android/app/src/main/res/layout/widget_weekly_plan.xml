<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weekly_plan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_wp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan Semanal"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_wp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunes a Domingo • StudentHub"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_wp_pending_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_active"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="4 tareas"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Boton de Voz para anadir eventos escuchando -->
            <ImageView
                android:id="@+id/btn_weekly_voice_add"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_circle_mic_bg"
                android:contentDescription="Añadir evento por voz"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_voice_mic" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- 7-Day Header Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="7">

        <!-- Lunes -->
        <LinearLayout
            android:id="@+id/col_day_lun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lun" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_lun_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_lun_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/widget_accent_default" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Martes -->
        <LinearLayout
            android:id="@+id/col_day_mar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mar" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_mar_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_mar_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="@color/widget_accent_default" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Miercoles -->
        <LinearLayout
            android:id="@+id/col_day_mie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mié" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_mie_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_mie_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/widget_accent_default" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Jueves -->
        <LinearLayout
            android:id="@+id/col_day_jue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jue" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_jue_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_jue_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/widget_text_muted" android:textSize="12sp" />
        </LinearLayout>

        <!-- Viernes -->
        <LinearLayout
            android:id="@+id/col_day_vie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vie" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_vie_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_vie_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/widget_accent_default" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Sabado -->
        <LinearLayout
            android:id="@+id/col_day_sab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sáb" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_sab_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_sab_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/widget_text_muted" android:textSize="12sp" />
        </LinearLayout>

        <!-- Domingo -->
        <LinearLayout
            android:id="@+id/col_day_dom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dom" android:textColor="@color/widget_text_secondary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_dom_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_wp_day_dom_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="@color/widget_accent_default" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- List of All Events of Every Day of the Week -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_weekly_plan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_wp_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No hay tareas programadas para esta semana"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/btn_open_tasks_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="right|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_wp_btn_open_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abrir Auto-Organizador ->"
            android:textColor="@color/widget_accent_default"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
