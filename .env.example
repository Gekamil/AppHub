# ==============================================================================
# StudentHub / AppHub - Plantilla de Variables de Entorno
# Copia este archivo como .env para desarrollo local o añádelas en el panel de Render
# ==============================================================================

# Puerto del servidor backend de WhatsApp / API (por defecto: 5005)
PORT=5005

# Clave API de Groq Cloud (requerida en Render para el bot de WhatsApp y proxy de IA)
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=tu_clave_groq_aqui

# Token de GitHub (opcional si el repositorio es público; requerido si es privado para descargas de releases)
# Formato: ghp_... o gho_... con permisos read:packages / repo
GITHUB_TOKEN=

# [Opcional para Frontend Vite]: Clave cliente directa de Groq (si se deja vacía, usa el proxy del backend en Render)
VITE_GROQ_API_KEY=
