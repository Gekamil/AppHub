{
  "name": "studenthub",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/whatsapp-bridge.js",
    "cap:sync": "vite build && cap sync",
    "cap:open": "cap open android",
    "build:electron": "node scripts/bundle-electron.cjs",
    "electron:start": "npm run build:electron && electron .",
    "electron:build": "vite build && npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.studenthub.workspace",
    "productName": "StudentHub",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/main.src.cjs",
      "!dist/download/**/*",
      "!node_modules/**/*"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "es",
      "en-US",
      "en"
    ],
    "afterPack": "scripts/prune-pack.cjs",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudentHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Gekamil",
        "repo": "AppHub"
      }
    ]
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "electron-updater": "^6.8.9",
    "firebase": "^13.0.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0"
  }
}
