<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="6dp"
    android:paddingRight="4dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/tv_header_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lunes, 19 Oct"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_header_today_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:background="@drawable/widget_pill_active"
        android:paddingLeft="5dp"
        android:paddingTop="1dp"
        android:paddingRight="5dp"
        android:paddingBottom="1dp"
        android:text="HOY"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_weight="1"
        android:background="#E2E8F0"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_header_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2 tareas"
        android:textColor="#64748B"
        android:textSize="10sp" />
</LinearLayout>
